# npm writes a debug log of every run, with its full command line, to ~/.npm/_logs: `npm run sst -- auth.login
# --password x` or `-- turn --content "..."` would leave the password or the text there in plain text (T06).
# So no debug logs for npm runs in this project. logs-dir keeps npm's pruning (logs-max) away from the logs of
# other projects in ~/.npm/_logs. npm still prints its errors to the terminal. Prefer ./sst anyway: npm shows its
# arguments in ps while the command runs.
logs-dir=.run/npm-logs
logs-max=0
